# Vision model. One call per camera frame.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5-5
# low is the quickest. Raise it for more careful portion estimates.
VISION_EFFORT=low
# Language of the spoken sentences and food names: en or fi.
SPEECH_LANGUAGE=en
# Optional. Shown as a progress bar and spoken in the summary.
DAILY_KCAL_GOAL=
# Set this whenever the API is reachable from outside this machine (a tunnel, a shared network).
# Clients send it as the X-Api-Token header or a ?token= query.
API_TOKEN=
# How many times food must be seen before it is logged, and how long a meal stays open without being seen.
CONFIRM_SIGHTINGS=2
MEAL_GAP_SECONDS=1200
TIMEZONE=Europe/Helsinki
DB_PATH=data/glasses.db
# Only needed if a web app on another origin calls this API.
CORS_ORIGINS=
