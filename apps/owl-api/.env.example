ANTHROPIC_API_KEY=
MODEL_ID=claude-opus-5-5
# Optional shared secret. The glasses app and Owl Studio send it as the X-Api-Token header.
API_TOKEN=
# The https tunnel address. Needed for video clips on the glasses: the DAT VideoPlayer plays https URLs only.
PUBLIC_BASE_URL=

# 1 = answer from fixtures instead of the model, for UI work without an API key.
OWL_MOCK_CHECK=
OWL_MOCK_ASK=
OWL_MOCK_RECORD=
# 1 = start clean from the fixtures, ignoring data/state.json (rehearsals).
OWL_RESET=
# 1 = demo mode: the demo story plays without models (fixtures/demo-script.json). See the contract.
OWL_DEMO=
# With OWL_DEMO=1: the parts that still use the live models, any of check,recognize,place (real glasses).
OWL_DEMO_LIVE=
# 1 = the log also says what the camera saw (Nemotron's summary, V-JEPA's action words). Rehearsals only: by default
# Owl keeps no record of a worker's view.
OWL_DEBUG_LOG=
# The company for new workers without a task and for recordings. Default: the demo worker's company.
OWL_COMPANY=

# Owl Check
# Who looks at the check frames: claude (MODEL_ID) or nemotron (NVIDIA Nemotron 3.5 Super VL on a Verda GPU; Claude
# answers when it fails and ANTHROPIC_API_KEY is set).
VISION_BACKEND=claude
VERDA_INFERENCE_KEY=
NEMOTRON_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
NEMOTRON_MODEL=nemotron-3.5-super-vl
# Who writes customer service hints: claude (MODEL_ID) or nemotron (on Verda; the local search answers when it fails).
# Either way a hint passes only with a quote found word for word in the documents.
ASSIST_BACKEND=claude
# Effort of the Claude vision call (low keeps a check under 4 s).
VISION_EFFORT=low
# Jev, TypeSafe's decision model. Without a key the deterministic rules decide alone.
JEV_API_KEY=
JEV_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
# Owl acts on a problem only when Jev agrees with at least this probability. Tune on labelled frames.
JEV_THRESHOLD=0.75

# Ask: effort of the answer call.
ASK_EFFORT=low
# Above this many characters in all documents, Ask sends only the best sections (local BM25).
ASK_MAX_CHARS=60000

# Record: effort of the call that writes a process from the narration.
RECORD_EFFORT=medium

# Step recognition (JUN-34): baseline (default) or vjepa2 (run with `uv run --extra jepa ...`). The SSv2 model was the
# best on real clips (JUN-34); V-JEPA 2.1 (ViT-B/L, mean or few-shot probe) did not beat it on Kinetics.
JEPA_BACKEND=baseline
JEPA_MODEL=facebook/vjepa2-vitl-fpc16-256-ssv2
JEPA_MIN_MARGIN=0.02
